{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "drizzle.config.ts"],
  "exclude": ["src/**/*.test.ts", "vitest.config.ts"]
}
